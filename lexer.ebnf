COMMENT -> "/*" ( !('*') | '*' !('/') )* "*/" ;
COMMENT -> "//" !('\n')* '\n' ;
COMMENT -> ( ' ' | '\n' | '\r' | '\t' )+ ;

INTEGER -> [0-9]+ ;
FLOAT -> [0-9]+ '.' [0-9]+ ;
STRING -> '\"'  ( !( '\\' | '\"' )  | '\\' . )*  '\"' ;
CHAR -> '\'' ( !('\\' | '\'' ) | '\\' . ) '\'' ;
IDENTIFIER -> ( [a-z] | [A-Z] | '_' ) ( [a-z] | [A-Z] | [0-9] | '_' )* ;